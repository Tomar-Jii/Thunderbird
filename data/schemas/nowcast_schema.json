{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StormSightNowcastResponse",
  "type": "object",
  "required": [
    "locationId",
    "locationName",
    "latitude",
    "longitude",
    "issuedAt",
    "currentRisk",
    "stormProbabilityPct",
    "lightningProbabilityPct",
    "confidencePct",
    "horizons",
    "atmosphericSounding",
    "explainability"
  ],
  "properties": {
    "locationId": { "type": "string" },
    "locationName": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "currentRisk": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH", "SEVERE"] },
    "stormProbabilityPct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "lightningProbabilityPct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "confidencePct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "leadTimeMinutes": { "type": "integer", "default": 120 },
    "horizons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "minutesAhead",
          "stormProbabilityPct",
          "lightningProbabilityPct",
          "confidencePct",
          "riskLevel"
        ]
      }
    }
  }
}
